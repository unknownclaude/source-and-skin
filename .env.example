# Everything here is optional. Unset, the site runs on its static catalogue,
# reports honestly that forms and payments are not connected, and nothing
# breaks. Set each one as you turn that piece on.

# --- Where the site is served from ----------------------------------------
# The canonical origin: drives canonical links, Open Graph URLs, the sitemap
# and the product JSON-LD. Set it to the real domain in production. Left
# unset, a Vercel deployment uses its own hostname, and anything else falls
# back to the domain in data/site.ts.
NEXT_PUBLIC_SITE_URL=

# --- The checkout handoff -------------------------------------------------
# The store to send a finished bag to. Setting this BEFORE Shopify Payments is
# activated is the one genuinely bad move available: Shopify will render a
# checkout that cannot complete, and a customer who gets that far and fails
# does not come back. Turn on a method in data/payments.ts at the same time.
NEXT_PUBLIC_SHOPIFY_DOMAIN=

# --- Live prices and stock ------------------------------------------------
# Storefront API token, read server-side only — deliberately not NEXT_PUBLIC,
# so it never reaches the browser. Shopify admin → Settings → Apps and sales
# channels → Develop apps → create an app → Storefront API → enable
# unauthenticated_read_product_listings → install → reveal the token.
# Without it, prices and availability come from data/products.ts.
SHOPIFY_STOREFRONT_TOKEN=

# Points the Storefront client somewhere other than the domain above. Only for
# testing against a mock; leave unset in production.
# SHOPIFY_STOREFRONT_ENDPOINT=

# --- The contact form -----------------------------------------------------
# Without these, /api/contact returns 503 and the form shows the business email
# rather than reporting a success it did not have.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# --- Analytics ------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
